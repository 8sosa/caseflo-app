rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in user (email verification not required — enforced in app UI instead)
    function isAuth() {
      return request.auth != null;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuth() && request.auth.uid == resource.data.uid;
    }

    function isValidString(val, min, max) {
      return val is string && val.size() >= min && val.size() <= max;
    }

    function hasOnlyAllowedFields(fields) {
      return incoming().diff({}).affectedKeys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !incoming().diff(existing()).affectedKeys().hasAny(fields);
    }

    function isOrgMember(orgId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function canAccessDoc() {
      return isDocOwner() ||
        (isAuth() && resource.data.get('orgId', null) != null && isOrgMember(resource.data.orgId));
    }

    // ── Deny-all default ────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Organizations ───────────────────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if isAuth();
      allow create: if isAuth() && incoming().adminUid == request.auth.uid;
      allow update: if isAuth() && (isOrgMember(orgId) || resource.data.adminUid == request.auth.uid);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isAuth();
        allow create: if isAuth() && memberId == request.auth.uid;
        allow update: if isAuth() && memberId == request.auth.uid;
        allow delete: if isAuth() && (memberId == request.auth.uid || request.auth.uid == get(/databases/$(database)/documents/organizations/$(orgId)).data.adminUid);
      }
    }

    // ── Users ───────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isAuth() && userId == request.auth.uid;
      allow update: if isAuth() && userId == request.auth.uid;
      allow delete: if false;
    }

    // ── Legal Data Collections ──────────────────────────────────────────────────
    match /matters/{matterId} {
      allow read: if canAccessDoc();
      allow create: if isAuth() && incoming().uid == request.auth.uid;
      allow update: if canAccessDoc() && areImmutableFieldsUnchanged(['uid']);
      allow delete: if canAccessDoc();
    }

    match /appointments/{appointmentId} {
      allow read: if canAccessDoc();
      allow create: if isAuth() && incoming().uid == request.auth.uid;
      allow update: if canAccessDoc() && areImmutableFieldsUnchanged(['uid', 'matterId']);
      allow delete: if canAccessDoc();
    }

    match /followUps/{followUpId} {
      allow read: if canAccessDoc();
      allow create: if isAuth() && incoming().uid == request.auth.uid;
      allow update: if canAccessDoc() && areImmutableFieldsUnchanged(['uid', 'matterId']);
      allow delete: if canAccessDoc();
    }

    match /filings/{filingId} {
      allow read: if canAccessDoc();
      allow create: if isAuth() && incoming().uid == request.auth.uid;
      allow update: if canAccessDoc();
      allow delete: if canAccessDoc();
    }

    match /caseTemplates/{templateId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || (resource.data.get('orgId', null) != null && isOrgMember(resource.data.orgId)));
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.userId == request.auth.uid || (resource.data.get('orgId', null) != null && isOrgMember(resource.data.orgId)));
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || (resource.data.get('orgId', null) != null && isOrgMember(resource.data.orgId)));
    }

    match /agreements/{agId} {
      allow read: if canAccessDoc();
      allow create: if isAuth() && incoming().uid == request.auth.uid;
      allow update: if canAccessDoc() && areImmutableFieldsUnchanged(['uid', 'createdAt']);
      allow delete: if canAccessDoc();
    }

    match /emails/{emailId} {
      allow read: if canAccessDoc();
      allow create: if isAuth() && incoming().uid == request.auth.uid;
      allow update: if canAccessDoc() && areImmutableFieldsUnchanged(['uid']);
      allow delete: if canAccessDoc();
    }

    match /vetting/{vetId} {
      allow read: if canAccessDoc();
      allow create: if isAuth() && incoming().uid == request.auth.uid;
      allow update: if false;
      allow delete: if canAccessDoc();
    }

    match /invoices/{invoiceId} {
      allow read: if canAccessDoc();
      allow create: if isAuth() && incoming().uid == request.auth.uid;
      allow update: if canAccessDoc() && areImmutableFieldsUnchanged(['uid', 'matterId', 'currency', 'createdAt']);
      allow delete: if canAccessDoc() && existing().status == 'draft';
    }

  }
}
