# ── AI ──────────────────────────────────────────────────────────────────────────
# Required for Gemini AI features (case vetting, etc.)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ── Server ───────────────────────────────────────────────────────────────────────
# The URL where this app is hosted (used for Paystack callback URLs, OAuth redirects)
APP_URL="http://localhost:3000"

# ── Paystack ─────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=

# ── Google OAuth (Gmail Sync) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft OAuth (Exchange Sync) ──────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Firebase Admin SDK (Optional — enables server-side org management) ────────────
# Create a service account at: Firebase Console → Project Settings → Service Accounts
# Download the JSON key, then paste its content (minified) here:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT_KEY=
